# Copy to .env and adjust. FAKE placeholder values only - never commit real secrets.

SENTINEL_REDIS_URL=redis://127.0.0.1:6379/0
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5432/sentinel
SENTINEL_DB_CONNECT_TIMEOUT_S=5
SENTINEL_DB_POOL_SIZE=5
SENTINEL_REDIS_CONNECT_TIMEOUT_S=2.0
SENTINEL_REDIS_SOCKET_TIMEOUT_S=2.0

# Session tracker
SENTINEL_SESSION_TTL_S=86400
SENTINEL_SESSION_HISTORY_LEN=20
SENTINEL_SESSION_RISK_HALF_LIFE_S=600

# Decision log (async bounded queue; DB outages never block decisions)
SENTINEL_DECISION_LOG_QUEUE_SIZE=10000
SENTINEL_DECISION_LOG_BATCH_SIZE=200
SENTINEL_DECISION_LOG_FLUSH_TIMEOUT_S=10

# Raw capture of FULL UNREDACTED events for dataset building. Sandbox only:
# refused unless SENTINEL_SANDBOX_MODE=true or SANDBOX_IN_CONTAINER=1.
SENTINEL_CAPTURE_MODE=false
SENTINEL_CAPTURE_DIR=data/raw
SENTINEL_SANDBOX_MODE=false

SENTINEL_POLICY_PATH=policies/default.yaml
SENTINEL_SHADOW_MODE=true
SENTINEL_DEFAULT_FAIL_MODE=closed

# Tool output text kept per event (full text is sha256-hashed)
SENTINEL_OUTPUT_MAX_CHARS=16000

SENTINEL_GUARD_URL=http://localhost:8001/v1
SENTINEL_GUARD_TIMEOUT_MS=800

SENTINEL_FAST_TIER_MODEL_PATH=models/fast_tier/model.onnx
# Placeholders until calibrated on val (fast_tier/calibrate.py)
SENTINEL_FAST_ALLOW_THRESHOLD=0.2
SENTINEL_FAST_BLOCK_THRESHOLD=0.9

SENTINEL_ADMIN_API_KEY=change-me-fake-admin-key
SENTINEL_LOG_LEVEL=INFO
SENTINEL_MODEL_VERSION=policy-only-v0

# docker compose (local dev only, fake values)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
REDIS_PORT=6379
POSTGRES_PORT=5432
