# Copy to .env and adjust. FAKE placeholder values only - never commit real secrets.

SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

SENTINEL_POLICY_PATH=policies/default.yaml
SENTINEL_SHADOW_MODE=true
SENTINEL_DEFAULT_FAIL_MODE=closed

SENTINEL_GUARD_URL=http://localhost:8001/v1
SENTINEL_GUARD_TIMEOUT_MS=800

SENTINEL_FAST_TIER_MODEL_PATH=models/fast_tier/model.onnx
# Placeholders until calibrated on val (fast_tier/calibrate.py)
SENTINEL_FAST_ALLOW_THRESHOLD=0.2
SENTINEL_FAST_BLOCK_THRESHOLD=0.9

SENTINEL_ADMIN_API_KEY=change-me-fake-admin-key
SENTINEL_LOG_LEVEL=INFO
SENTINEL_MODEL_VERSION=policy-only-v0
